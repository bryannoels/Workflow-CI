      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(bigoracle_requests_total[1m]))",
          "legendFormat": "{{status}}",
          "range": true,
          "instant": false
