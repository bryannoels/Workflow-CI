    {
      "id": 8,
      "type": "timeseries",
      "title": "P95 Request Latency (bigoracle_request_latency_seconds)",
      "description": "Persentil ke-95 latensi end-to-end; garis merah = ambang alert (0,5 detik)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bigoracle_request_latency_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
