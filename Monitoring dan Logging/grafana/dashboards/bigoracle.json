    {
      "id": 7,
      "type": "timeseries",
      "title": "Request Throughput (bigoracle_requests_total)",
      "description": "Permintaan per detik berdasarkan status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
