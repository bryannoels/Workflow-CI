FROM --platform=linux/arm64 python:3.12-slim

WORKDIR /app

COPY artifacts/latest/model/requirements.txt /tmp/model-requirements.txt

RUN python -m pip install --no-cache-dir -r /tmp/model-requirements.txt

COPY artifacts/latest/model/ /opt/ml/model/

ENV MLFLOW_MODELS_WORKERS=1

EXPOSE 8080

CMD ["mlflow", "models", "serve", \
     "--model-uri", "/opt/ml/model", \
     "--host", "0.0.0.0", \
     "--port", "8080", \
     "--env-manager", "local"]
