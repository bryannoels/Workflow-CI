name: bigoracle-ci

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      data_dir: {type: string, default: "codecomplex_preprocessing"}
      n_estimators: {type: int, default: 400}
      max_depth: {type: string, default: "None"}
      min_samples_leaf: {type: int, default: 1}
      seed: {type: int, default: 42}
    command: >
      python modelling.py
      --data-dir {data_dir}
      --n-estimators {n_estimators}
      --max-depth {max_depth}
      --min-samples-leaf {min_samples_leaf}
      --seed {seed}